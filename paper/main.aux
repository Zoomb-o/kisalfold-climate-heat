\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Projected Carpathian Basin July mean T2m under SSP2-4.5 (blue) and SSP5-8.5 (red). Left: absolute temperature. Right: anomaly relative to the 1995--2010 historical baseline, with Paris Agreement 1.5\,°C and 2.0\,°C thresholds shown. Shaded bands represent $\pm $0.3\,°C uncertainty range. CMIP6 MPI-ESM1-2-LR, r1i1p1f1, accessed via Earth2Studio.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:warming}{{5}{7}{Projected Carpathian Basin July mean T2m under SSP2-4.5 (blue) and SSP5-8.5 (red). Left: absolute temperature. Right: anomaly relative to the 1995--2010 historical baseline, with Paris Agreement 1.5\,°C and 2.0\,°C thresholds shown. Shaded bands represent $\pm $0.3\,°C uncertainty range. CMIP6 MPI-ESM1-2-LR, r1i1p1f1, accessed via Earth2Studio}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Decade-mean warming anomaly (°C vs 1995--2010 baseline) under SSP2-4.5 and SSP5-8.5 for five future decades. Both scenarios exceed the Paris 2\,°C regional threshold before 2035. The 2065--2074 decade sees +4.5\,°C (SSP2-4.5) and +6.0\,°C (SSP5-8.5) regional warming.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:scenario}{{6}{7}{Decade-mean warming anomaly (°C vs 1995--2010 baseline) under SSP2-4.5 and SSP5-8.5 for five future decades. Both scenarios exceed the Paris 2\,°C regional threshold before 2035. The 2065--2074 decade sees +4.5\,°C (SSP2-4.5) and +6.0\,°C (SSP5-8.5) regional warming}{figure.caption.8}{}}
\citation{ipcc2021}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Spatial distribution of projected July T2m warming anomaly under SSP5-8.5 for each future decade. The southern Carpathian Basin consistently warms faster than northern areas. By the 2065--2074 decade, most of the domain exceeds +6\,°C above the 1995--2010 baseline. CMIP6 MPI-ESM1-2-LR, r1i1p1f1.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:spatialmaps}{{7}{8}{Spatial distribution of projected July T2m warming anomaly under SSP5-8.5 for each future decade. The southern Carpathian Basin consistently warms faster than northern areas. By the 2065--2074 decade, most of the domain exceeds +6\,°C above the 1995--2010 baseline. CMIP6 MPI-ESM1-2-LR, r1i1p1f1}{figure.caption.9}{}}
